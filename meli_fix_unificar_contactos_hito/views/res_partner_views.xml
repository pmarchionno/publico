<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Vista form de res.partner - agregar campos de unificación -->
        <record id="view_partner_form_meli_unificado" model="ir.ui.view">
            <field name="name">res.partner.form.meli.unificado</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="meli_contacto_unificado" invisible="1"/>
                    <field name="meli_unificado_desde" 
                           attrs="{'invisible': [('meli_contacto_unificado', '=', False)]}"
                           readonly="1"/>
                </xpath>
                
                <!-- Mostrar banner si el contacto fue unificado -->
                <xpath expr="//sheet" position="before">
                    <div class="alert alert-info" role="alert" attrs="{'invisible': [('meli_contacto_unificado', '=', False)]}">
                        <strong>¡Atención!</strong> Este contacto fue unificado desde otro contacto de MercadoLibre.
                        <field name="meli_unificado_desde" readonly="1" options="{'no_open': True}"/>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- Vista tree de res.partner - agregar indicador de unificado -->
        <record id="view_partner_tree_meli_unificado" model="ir.ui.view">
            <field name="name">res.partner.tree.meli.unificado</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="meli_contacto_unificado" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>