<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Vista del wizard -->
        <record id="view_unificar_contactos_wizard_form" model="ir.ui.view">
            <field name="name">unificar.contactos.wizard.form</field>
            <field name="model">meli_fix_unificar_contactos_hito.unificar_contactos_wizard</field>
            <field name="arch" type="xml">
                <form string="Unificar Contactos Duplicados de MercadoLibre">
                    <sheet>
                        <group>
                            <field name="modo_ejecucion" widget="radio"/>
                            <field name="criterio_unificacion" widget="radio"/>
                        </group>
                        <group>
                            <field name="contactos_encontrados"/>
                            <field name="contactos_unificados"/>
                        </group>
                        <notebook>
                            <page string="Resultado">
                                <field name="resultado" nolabel="1" placeholder="Ejecute 'Buscar contactos' para ver los resultados..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_buscar_contactos" string="Buscar Contactos" type="object" class="btn-primary"/>
                        <button name="action_unificar_contactos" string="Unificar Contactos" type="object" class="btn-success" attrs="{'invisible': [('modo_ejecucion', '=', 'simulacion')]}">
                            <i class="fa fa-warning"/> ¡Cuidado! Esta acción modificará datos.
                        </button>
                        <button name="action_cerrar" string="Cerrar" type="object" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción del wizard -->
        <record id="action_unificar_contactos_wizard" model="ir.actions.act_window">
            <field name="name">Unificar Contactos ML</field>
            <field name="res_model">meli_fix_unificar_contactos_hito.unificar_contactos_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menú -->
        <menuitem id="menu_unificar_contactos"
                  name="Unificar Contactos ML"
                  parent="meli_oerp.menu_meli_oerp"
                  action="action_unificar_contactos_wizard"
                  sequence="100"/>
    </data>
</odoo>